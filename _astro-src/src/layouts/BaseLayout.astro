---
// BaseLayout.astro — Main layout (mobile-first)
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  lang: 'ro' | 'en';
  title: string;
  description: string;
  canonical: string;
  hreflangRo: string;
  hreflangEn: string;
  activePage?: string;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  schemaJson?: string;
  keywords?: string;
}

const {
  lang,
  title,
  description,
  canonical,
  hreflangRo,
  hreflangEn,
  activePage,
  ogImage,
  ogImageAlt,
  noindex,
  schemaJson,
  keywords,
} = Astro.props;
---

<!doctype html>
<html lang={lang === 'en' ? 'en' : 'ro'}>
<head>
  <SEOHead
    lang={lang}
    title={title}
    description={description}
    canonical={canonical}
    hreflangRo={hreflangRo}
    hreflangEn={hreflangEn}
    ogImage={ogImage}
    ogImageAlt={ogImageAlt}
    noindex={noindex}
    schemaJson={schemaJson}
    keywords={keywords}
  />
</head>
<body>
  <a class="skip-link" href="#main-content">
    {lang === 'en' ? 'Skip to content' : 'Sari la conținut'}
  </a>

  <Header lang={lang} activePage={activePage} />

  <main id="main-content">
    <slot />
  </main>

  <Footer lang={lang} />

  <!-- Runtime scripts (external, defer — no is:inline on src= tags) -->
  <script src="/js/config.js?v=20260510a" defer></script>
  <script src="/js/mobile-menu.js?v=20260510a" defer></script>
  <script src="/js/dark-mode.js?v=20260510a" defer></script>
  <script src="/js/reveal.js?v=20260424a" defer></script>
</body>
</html>

<style is:global>
  /* Mobile-first reveal animation */
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: none;
  }
</style>

---
// src/pages/en/index.astro — English homepage (x-default, international primary)
import BaseLayout from '../../layouts/BaseLayout.astro';

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://zypherolab.com/#organization",
      "name": "ZypheroLab",
      "url": "https://zypherolab.com/",
      "foundingDate": "2024",
      "description": "ZypheroLab builds premium, conversion-focused websites for international and Romanian SMBs. Fast delivery, technical SEO, and measurable lead growth.",
      "logo": {
        "@type": "ImageObject",
        "url": "https://zypherolab.com/img/brand/zypherolab-logo.webp",
        "width": 512,
        "height": 512
      },
      "image": "https://zypherolab.com/img/brand/og-image.png",
      "email": "hello@zypherolab.com",
      "telephone": "+40747821384",
      "address": { "@type": "PostalAddress", "addressCountry": "RO" },
      "priceRange": "€€",
      "knowsAbout": ["Web Design","Technical SEO","Conversion Optimization","HTML","CSS","JavaScript","GitHub Pages","Cloudflare"],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "sales",
        "telephone": "+40747821384",
        "email": "hello@zypherolab.com",
        "url": "https://zypherolab.com/en/contact",
        "availableLanguage": ["English","Romanian"]
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://zypherolab.com/#website",
      "url": "https://zypherolab.com/",
      "name": "ZypheroLab",
      "publisher": { "@id": "https://zypherolab.com/#organization" },
      "inLanguage": ["ro-RO","en-US"]
    },
    {
      "@type": "WebPage",
      "@id": "https://zypherolab.com/en/#webpage",
      "url": "https://zypherolab.com/en/",
      "name": "ZypheroLab | Premium websites that win clients",
      "description": "ZypheroLab builds premium, conversion-focused websites for international businesses. Technical SEO, clear UX, and measurable lead growth.",
      "isPartOf": { "@id": "https://zypherolab.com/#website" },
      "about": { "@id": "https://zypherolab.com/#organization" },
      "inLanguage": "en-US"
    },
    {
      "@type": "ProfessionalService",
      "@id": "https://zypherolab.com/#service",
      "name": "ZypheroLab",
      "url": "https://zypherolab.com/en/",
      "telephone": "+40747821384",
      "email": "hello@zypherolab.com",
      "provider": { "@id": "https://zypherolab.com/#organization" },
      "serviceType": ["Web Design","Technical SEO","Conversion Optimization"],
      "areaServed": ["Worldwide"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "ZypheroLab Web Packages",
        "itemListElement": [
          { "@type": "Offer", "name": "Starter", "description": "Complete commercial landing page with baseline technical SEO. Delivered in 3-5 business days.", "price": "300", "priceCurrency": "EUR" },
          { "@type": "Offer", "name": "Growth", "description": "Multi-page website with advanced technical SEO, KPI reporting, and priority support.", "price": "600", "priceCurrency": "EUR" },
          { "@type": "Offer", "name": "Custom", "description": "Custom architecture, API integrations, and flexible timeline. Price on request." }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://zypherolab.com/en/#faq",
      "mainEntity": [
        { "@type": "Question", "name": "How much does a website cost?", "acceptedAnswer": { "@type": "Answer", "text": "Landing page from €300, full multi-page site from €600. Final price depends on scope and complexity." } },
        { "@type": "Question", "name": "How fast is delivery?", "acceptedAnswer": { "@type": "Answer", "text": "For standard scope, the first functional version is delivered in 3-5 business days. Complex projects are scoped with you in advance." } },
        { "@type": "Question", "name": "Can I see examples of delivered sites?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Our portfolio includes links to live sites, active in production, not just static images." } },
        { "@type": "Question", "name": "Is hosting and domain included in the price?", "acceptedAnswer": { "@type": "Answer", "text": "No. We recommend buying the domain and hosting under your name for 100% control. We guide you through the process for free." } },
        { "@type": "Question", "name": "What happens after the 3 months of support?", "acceptedAnswer": { "@type": "Answer", "text": "The site will continue to work perfectly. For additional maintenance or new developments, we can discuss a recurring plan." } },
        { "@type": "Question", "name": "Do you redesign existing websites?", "acceptedAnswer": { "@type": "Answer", "text": "Yes, but we often rewrite the code from scratch to guarantee maximum performance, while keeping the old URLs for SEO." } },
        { "@type": "Question", "name": "How does the payment work?", "acceptedAnswer": { "@type": "Answer", "text": "A 50% upfront payment is required at signing to reserve time, and the remaining 50% upon project delivery and launch." } },
        { "@type": "Question", "name": "Do you work with international clients?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Fully remote, clients worldwide. Communication in English or Romanian. Same delivery timeline regardless of location." } },
        { "@type": "Question", "name": "What technologies do you use?", "acceptedAnswer": { "@type": "Answer", "text": "We build extremely fast websites using Astro, semantic HTML, and modern CSS. We do not use bloated platforms like WordPress." } },
        { "@type": "Question", "name": "What about analytics?", "acceptedAnswer": { "@type": "Answer", "text": "We don't install bloated tracking scripts. Results are tracked via Google Search Console — no third-party data sharing." } },
        { "@type": "Question", "name": "Can I edit content later?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We deliver clean, documented source code. You can edit it yourself or request changes from us at any time." } },
        { "@type": "Question", "name": "What if I need something custom?", "acceptedAnswer": { "@type": "Answer", "text": "Contact us with your requirements and we'll scope a custom solution — whether it's an e-commerce store or a web app." } }
      ]
    }
  ]
});
---

<BaseLayout
  lang="en"
  title="ZypheroLab | Premium websites that win clients"
  description="ZypheroLab builds premium, conversion-focused websites for international businesses. Technical SEO, fast delivery, measurable lead growth. From €300."
  canonical="https://zypherolab.com/en/"
  hreflangRo="https://zypherolab.com/"
  hreflangEn="https://zypherolab.com/en/"
  ogImageAlt="ZypheroLab — premium websites that win clients worldwide"
  keywords="website creation, web design, web development, technical seo, landing page, create online store, presentation website"
  schemaJson={schema}
>
  <!-- HERO — 2-column, mobile-first -->
  <section class="hero hero--home" aria-labelledby="hero-title">
    <div class="hero-inner">
      <div class="hero-copy">
        <div class="hero-badge">Remote · Worldwide · From €300</div>
        <h1 id="hero-title">Websites that<br>win clients.</h1>
        <p class="hero-subtitle">
          Premium, conversion-focused web design and technical SEO for businesses that want measurable growth — not just a pretty page.
        </p>
        <div class="hero-proof">
          <span>⚡ Live in 3-5 days</span>
          <span>🔒 No tracking. GSC only.</span>
          <span>🌍 Clients worldwide</span>
        </div>
        <div class="hero-actions">
          <a class="btn" href="/en/contact/">Get a quote</a>
          <a class="btn btn-secondary" href="/en/case-studies/">See results</a>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <picture>
          <source srcset="/img/hero-device-mockup.jpg" type="image/jpeg">
          <img
            src="/img/hero-device-mockup.jpg"
            alt="Premium website design showcase on laptop — ZypheroLab"
            width="600"
            height="600"
            loading="eager"
            decoding="async"
            class="hero-mockup-img"
          >
        </picture>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="services reveal" aria-labelledby="services-title">
    <div class="section-inner">
      <h2 id="services-title">What you get</h2>
      <div class="cards cards--3">
        <article class="card card--icon">
          <span class="card-icon" aria-hidden="true">🎯</span>
          <h3>Conversion website</h3>
          <p>Clear commercial structure, strong CTA hierarchy, and mobile-first UX — designed to turn visitors into leads.</p>
        </article>
        <article class="card card--icon">
          <span class="card-icon" aria-hidden="true">🔍</span>
          <h3>Technical SEO</h3>
          <p>Canonical, hreflang, schema markup, Core Web Vitals, and indexing setup — all handled from day one.</p>
        </article>
        <article class="card card--icon">
          <span class="card-icon" aria-hidden="true">📈</span>
          <h3>Growth iteration</h3>
          <p>Monthly optimization sprints based on GSC data — no analytics bloat, only signals that matter.</p>
        </article>
      </div>
      <div class="section-cta">
        <a class="btn btn-secondary" href="/en/web-services/">All services →</a>
      </div>
    </div>
  </section>

  <!-- PRICING STRIP -->
  <section class="pricing pricing--strip reveal" aria-labelledby="pricing-title">
    <div class="section-inner">
      <h2 id="pricing-title">Transparent pricing</h2>
      <div class="pricing-grid">
        <article class="pricing-card">
          <h3>Starter</h3>
          <div class="pricing-price">€300</div>
          <ul class="pricing-features">
            <li>Complete landing page</li>
            <li>Baseline technical SEO</li>
            <li>Lead form + WhatsApp</li>
            <li>Live in 3-5 days</li>
          </ul>
          <a class="btn" href="/en/contact/">Get Starter</a>
        </article>
        <article class="pricing-card pricing-card--featured">
          <div class="pricing-badge">Most Popular</div>
          <h3>Growth</h3>
          <div class="pricing-price">€600</div>
          <ul class="pricing-features">
            <li>Multi-page website</li>
            <li>Advanced technical SEO</li>
            <li>KPI reporting via GSC</li>
            <li>Priority support 3 months</li>
          </ul>
          <a class="btn" href="/en/contact/">Get Growth</a>
        </article>
        <article class="pricing-card">
          <h3>Custom</h3>
          <div class="pricing-price">On request</div>
          <ul class="pricing-features">
            <li>E-commerce or app</li>
            <li>API integrations</li>
            <li>Flexible timeline</li>
            <li>Dedicated support</li>
          </ul>
          <a class="btn" href="/en/contact/">Get a quote</a>
        </article>
      </div>
      <div class="section-cta">
        <a class="btn btn-secondary" href="/en/web-pricing/">Full pricing details →</a>
      </div>
    </div>
  </section>

  <!-- WHY US -->
  <section class="features reveal" aria-labelledby="why-us-title">
    <div class="section-inner">
      <h2 id="why-us-title">Why work with us?</h2>
      <div class="cards cards--3">
        <article class="card card--icon">
          <span class="card-icon" aria-hidden="true">🤝</span>
          <h3>No middlemen</h3>
          <p>You communicate directly with the developer writing your code. No project managers, no lost information, and an extremely fast response time.</p>
        </article>
        <article class="card card--icon">
          <span class="card-icon" aria-hidden="true">⚡</span>
          <h3>Raw performance</h3>
          <p>Real loading speeds, not just artificial scores. Our custom-written sites consistently outperform heavy template-based solutions.</p>
        </article>
        <article class="card card--icon">
          <span class="card-icon" aria-hidden="true">🔓</span>
          <h3>Zero dependencies</h3>
          <p>You pay for the site once and own it 100%. We don't lock you into mandatory subscriptions, hidden platform costs, or encrypted code.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- PORTFOLIO STRIP -->
  <section class="portfolio reveal" aria-labelledby="portfolio-title">
    <div class="section-inner">
      <h2 id="portfolio-title">Projects delivered</h2>
      <div class="portfolio-grid">
        <article class="portfolio-item">
          <h3>Restaurant landing page</h3>
          <ul class="portfolio-case">
            <li><span class="portfolio-case-type">Challenge:</span> Slow on mobile; reservations lost on the phone.</li>
            <li><span class="portfolio-case-type">Solution:</span> Mobile-first landing with clear menu + booking CTA.</li>
            <li><span class="portfolio-case-type">Outcome:</span> One unified contact flow; stable mobile experience.</li>
          </ul>
        </article>
        <article class="portfolio-item">
          <h3>Law firm website</h3>
          <ul class="portfolio-case">
            <li><span class="portfolio-case-type">Challenge:</span> Unclear service communication; low online trust.</li>
            <li><span class="portfolio-case-type">Solution:</span> Services page + appointment form + local SEO.</li>
            <li><span class="portfolio-case-type">Outcome:</span> Professional message and clear intake path.</li>
          </ul>
        </article>
        <article class="portfolio-item">
          <h3>E-commerce redesign</h3>
          <ul class="portfolio-case">
            <li><span class="portfolio-case-type">Challenge:</span> High cart abandonment; weak mobile experience.</li>
            <li><span class="portfolio-case-type">Solution:</span> Checkout redesign + conversion-led product pages.</li>
            <li><span class="portfolio-case-type">Outcome:</span> Estimated +40% sales post-launch.</li>
          </ul>
        </article>
      </div>
      <div class="section-cta">
        <a class="btn btn-secondary" href="/en/case-studies/">All case studies →</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq reveal" aria-labelledby="faq-title">
    <div class="section-inner">
      <h2 id="faq-title">Frequently asked questions</h2>
      <div class="cards cards--2">
        <article class="card">
          <h3>How much does a website cost?</h3>
          <p>Landing page from €300, full multi-page site from €600. Final price depends on scope and complexity.</p>
        </article>
        <article class="card">
          <h3>How fast is delivery?</h3>
          <p>For standard scope, the first functional version is delivered in 3-5 business days. Complex projects are scoped with you in advance.</p>
        </article>
        <article class="card">
          <h3>Can I see examples of delivered sites?</h3>
          <p>Yes. Our portfolio includes links to live sites, active in production, not just static images.</p>
        </article>
        <article class="card">
          <h3>Is hosting and domain included in the price?</h3>
          <p>No. We recommend buying the domain and hosting under your name for 100% control. We guide you through the process for free.</p>
        </article>
        <article class="card">
          <h3>What happens after the 3 months of support?</h3>
          <p>The site will continue to work perfectly. For additional maintenance or new developments, we can discuss a recurring plan.</p>
        </article>
        <article class="card">
          <h3>Do you redesign existing websites?</h3>
          <p>Yes, but we often rewrite the code from scratch to guarantee maximum performance, while keeping the old URLs for SEO.</p>
        </article>
        <article class="card">
          <h3>How does the payment work?</h3>
          <p>A 50% upfront payment is required at signing to reserve time, and the remaining 50% upon project delivery and launch.</p>
        </article>
        <article class="card">
          <h3>Do you work with international clients?</h3>
          <p>Yes. Fully remote, clients worldwide. Communication in English or Romanian. Same delivery timeline regardless of location.</p>
        </article>
        <article class="card">
          <h3>What technologies do you use?</h3>
          <p>We build extremely fast websites using Astro, semantic HTML, and modern CSS. We do not use bloated platforms like WordPress.</p>
        </article>
        <article class="card">
          <h3>What about analytics?</h3>
          <p>We don't install bloated tracking scripts. Results are tracked via Google Search Console — no third-party data sharing.</p>
        </article>
        <article class="card">
          <h3>Can I edit content later?</h3>
          <p>Yes. We deliver clean, documented source code. You can edit it yourself or request changes from us at any time.</p>
        </article>
        <article class="card">
          <h3>What if I need something custom?</h3>
          <p>Contact us with your requirements and we'll scope a custom solution — whether it's an e-commerce store or a web app.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- CONTACT CTA -->
  <section class="cta-section reveal" aria-labelledby="cta-title">
    <div class="section-inner cta-inner">
      <h2 id="cta-title">Ready to grow?</h2>
      <p>Share your main objective and we'll reply with scope and estimate within 24 business hours.</p>
      <div class="hero-actions">
        <a class="btn" href="/en/contact/">Get a quote</a>
        <a class="btn btn-secondary" href="https://wa.me/40747821384?text=Hi%2C%20I%E2%80%99d%20like%20a%20quote%20for%20a%20website.">WhatsApp</a>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://zypherolab.com/en/web-pricing#webpage",
      "url": "https://zypherolab.com/en/web-pricing",
      "name": "Web Pricing | ZypheroLab",
      "description": "Transparent ZypheroLab pricing: Starter from €300, Growth from €600, and Custom packages for conversion-focused websites worldwide.",
      "inLanguage": "en-US",
      "isPartOf": { "@id": "https://zypherolab.com/#website" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://zypherolab.com/en/" },
        { "@type": "ListItem", "position": 2, "name": "Web Pricing", "item": "https://zypherolab.com/en/web-pricing" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "What is the minimum launch budget?", "acceptedAnswer": { "@type": "Answer", "text": "The Starter package begins at EUR 300 for a complete commercial landing page ready for promotion." } },
        { "@type": "Question", "name": "When should we choose the Growth package?", "acceptedAnswer": { "@type": "Answer", "text": "Growth fits when you need a multi-page website, advanced technical SEO, and recurring KPI reporting." } },
        { "@type": "Question", "name": "Are there mandatory recurring fees?", "acceptedAnswer": { "@type": "Answer", "text": "There are no hidden mandatory recurring fees; maintenance and optimization subscriptions are optional." } }
      ]
    }
  ]
});
---

<BaseLayout
  lang="en"
  title="Web Pricing | ZypheroLab"
  description="Transparent ZypheroLab website pricing: Starter from €300, Growth from €600, and Custom packages for conversion-focused web projects worldwide."
  canonical="https://zypherolab.com/en/web-pricing"
  hreflangRo="https://zypherolab.com/preturi-web"
  hreflangEn="https://zypherolab.com/en/web-pricing"
  ogImageAlt="ZypheroLab — transparent web pricing from €300"
  activePage="pricing"
  schemaJson={schema}
>
  <section class="pricing" aria-labelledby="pricing-title">
    <div class="section-inner">
      <h1 id="pricing-title">Transparent pricing for growth</h1>
      <div class="pricing-grid">
        <article class="pricing-card">
          <h2>Starter</h2>
          <div class="pricing-price">€300</div>
          <ul class="pricing-features">
            <li>Complete landing page</li>
            <li>Baseline technical SEO</li>
            <li>Lead form + WhatsApp</li>
            <li>Launched in 3-5 days</li>
            <li>Email support 30 days</li>
          </ul>
          <a class="btn" href="/en/contact">Get Starter</a>
        </article>
        <article class="pricing-card pricing-card--featured">
          <div class="pricing-badge">Most Popular</div>
          <h2>Growth</h2>
          <div class="pricing-price">€600</div>
          <ul class="pricing-features">
            <li>Multi-page website</li>
            <li>Advanced technical SEO</li>
            <li>GSC monthly reports</li>
            <li>Launched in 5-7 days</li>
            <li>Priority support 3 months</li>
          </ul>
          <a class="btn" href="/en/contact">Get Growth</a>
        </article>
        <article class="pricing-card">
          <h2>Custom</h2>
          <div class="pricing-price">On request</div>
          <ul class="pricing-features">
            <li>E-commerce or application</li>
            <li>API integrations</li>
            <li>Custom scope & timeline</li>
            <li>Dedicated support</li>
          </ul>
          <a class="btn" href="/en/contact">Get a quote</a>
        </article>
      </div>
      <div class="section-cta">
        <a class="btn btn-secondary" href="/en/case-studies">View case studies →</a>
      </div>
    </div>
  </section>

  <section class="faq reveal" aria-labelledby="faq-title">
    <div class="section-inner">
      <h2 id="faq-title">Frequently asked questions about pricing</h2>
      <div class="cards cards--3">
        <article class="card">
          <h3>What is the minimum launch budget?</h3>
          <p>The Starter package begins at EUR 300 for a complete commercial landing page ready for promotion.</p>
        </article>
        <article class="card">
          <h3>When should we choose the Growth package?</h3>
          <p>Growth fits when you need a multi-page website, advanced technical SEO, and recurring KPI reporting.</p>
        </article>
        <article class="card">
          <h3>Are there mandatory recurring fees?</h3>
          <p>There are no hidden mandatory recurring fees; maintenance and optimization subscriptions are optional.</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

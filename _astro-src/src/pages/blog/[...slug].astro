---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.lang === 'ro');
  return posts.map(post => {
    // Strip the "ro/" prefix from the slug for the URL
    const slugWithoutLang = post.id.replace('ro/', '');
    return {
      params: { slug: slugWithoutLang },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);

const articleUrl = `https://zypherolab.com/blog/${Astro.params.slug}`;

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": articleUrl
  },
  "headline": post.data.title,
  "description": post.data.description,
  "author": {
    "@type": "Organization",
    "name": "ZypheroLab",
    "url": "https://zypherolab.com/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "ZypheroLab",
    "logo": {
      "@type": "ImageObject",
      "url": "https://zypherolab.com/img/brand/zypherolab-logo.png"
    }
  },
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": post.data.updatedDate ? post.data.updatedDate.toISOString() : post.data.pubDate.toISOString()
});
---

<BaseLayout
  lang="ro"
  title={`${post.data.title} | ZypheroLab`}
  description={post.data.description}
  canonical={articleUrl}
  hreflangRo={articleUrl}
  hreflangEn={articleUrl.replace('/blog/', '/en/blog/')}
  ogImageAlt={post.data.title}
  activePage="blog"
  schemaJson={schema}
>
  <article class="hero" style="text-align: left; max-width: 800px; margin: 0 auto;">
    <div class="hero-inner" style="align-items: flex-start;">
      <div class="hero-copy" style="max-width: 100%;">
        <div class="hero-badge">
          {post.data.pubDate.toLocaleDateString('ro-RO', { year: 'numeric', month: 'long', day: 'numeric' })}
        </div>
        <h1 style="font-size: clamp(2rem, 5vw, 3.5rem); margin-bottom: 1rem;">{post.data.title}</h1>
        <p class="hero-subtitle" style="margin-bottom: 2rem;">{post.data.description}</p>
        
        <div class="blog-content" style="line-height: 1.8; font-size: 1.1rem; color: var(--text);">
          <Content />
        </div>
        
        <div style="margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--border);">
          <a class="btn btn-secondary" href="/blog">← Înapoi la Blog</a>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style is:global>
  .blog-content h2 { margin-top: 2.5rem; margin-bottom: 1rem; font-size: 1.8rem; }
  .blog-content h3 { margin-top: 2rem; margin-bottom: 0.75rem; font-size: 1.4rem; }
  .blog-content p { margin-bottom: 1.5rem; }
  .blog-content ul, .blog-content ol { margin-bottom: 1.5rem; padding-left: 1.5rem; }
  .blog-content li { margin-bottom: 0.5rem; }
  .blog-content strong { font-weight: 600; color: var(--text); }
</style>

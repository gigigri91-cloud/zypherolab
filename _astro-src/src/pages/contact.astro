---
import BaseLayout from '../layouts/BaseLayout.astro';

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "@id": "https://zypherolab.com/contact#webpage",
      "url": "https://zypherolab.com/contact",
      "name": "Contact | ZypheroLab",
      "description": "Contactează ZypheroLab pentru o ofertă site web, redesign sau audit SEO tehnic. Răspuns în 24 de ore lucrătoare.",
      "inLanguage": "ro-RO",
      "isPartOf": { "@id": "https://zypherolab.com/#website" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Acasă", "item": "https://zypherolab.com/" },
        { "@type": "ListItem", "position": 2, "name": "Contact", "item": "https://zypherolab.com/contact" }
      ]
    }
  ]
});
---

<BaseLayout
  lang="ro"
  title="Contact | ZypheroLab"
  description="Contactează ZypheroLab pentru o ofertă site web, redesign sau audit SEO tehnic. Răspuns în 24 de ore lucrătoare. Disponibil remote, în toată lumea."
  canonical="https://zypherolab.com/contact"
  hreflangRo="https://zypherolab.com/contact"
  hreflangEn="https://zypherolab.com/en/contact"
  ogImageAlt="ZypheroLab — contact pentru ofertă site web"
  activePage="contact"
  schemaJson={schema}
>
  <section class="contact" aria-labelledby="contact-title">
    <div class="section-inner">
      <h1 id="contact-title">Cere ofertă</h1>
      <p class="offer-lead">Spune-ne obiectivul principal și răspundem cu direcție, scope și estimare în 24 de ore lucrătoare.</p>
      <div class="cards cards--2">
        <article class="card card--icon">
          <span class="card-icon" aria-hidden="true">✉️</span>
          <h2>Email</h2>
          <p><a href="mailto:hello@zypherolab.com">hello@zypherolab.com</a></p>
        </article>
        <article class="card card--icon">
          <span class="card-icon" aria-hidden="true">💬</span>
          <h2>WhatsApp</h2>
          <p><a href="https://wa.me/40747821384?text=Bună%2C%20vreau%20o%20ofertă%20pentru%20un%20site.">+40 747 821 384</a></p>
        </article>
      </div>
      <div class="section-cta">
        <a class="btn" href="/preturi-web/">Vezi prețuri</a>
        <a class="btn btn-secondary" href="/studii-de-caz/">Vezi studii de caz</a>
      </div>
    </div>
  </section>

  <section class="faq reveal" aria-labelledby="faq-title">
    <div class="section-inner">
      <h2 id="faq-title">Întrebări frecvente</h2>
      <div class="cards cards--3">
        <article class="card">
          <h3>Cât de repede răspundeți?</h3>
          <p>Răspundem în 24 de ore lucrătoare cu pașii următori și o direcție de implementare.</p>
        </article>
        <article class="card">
          <h3>Ce detalii să trimitem?</h3>
          <p>Te rugăm să specifici obiectivul principal, tipul afacerii, bugetul aproximativ și termenul dorit.</p>
        </article>
        <article class="card">
          <h3>Putem solicita doar un audit SEO?</h3>
          <p>Da, putem realiza un audit SEO tehnic standalone și furniza recomandări acționabile pentru site-ul tău actual.</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
